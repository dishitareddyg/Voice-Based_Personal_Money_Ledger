# ---------------------------------------------------------------------------
# Voice-Enabled Personal Financial Ledger - Raspberry Pi server
# Copy this file to .env and replace every "change-me" value.
# NEVER commit the real .env file.
# ---------------------------------------------------------------------------

ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# --- MySQL 8.x: the single database (ledger, auth, audit, voice, FX cache) -
# Either provide DATABASE_URL, or the individual MYSQL_* values below.
# DATABASE_URL=mysql+pymysql://voice_ledger:change-me@127.0.0.1:3306/voice_ledger?charset=utf8mb4
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=voice_ledger
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=voice_ledger
MYSQL_CHARSET=utf8mb4

# --- Connection pool (per Uvicorn worker; sized for a 2 GB Raspberry Pi) ----
# Total connections = workers x (DB_POOL_SIZE + DB_MAX_OVERFLOW). The server
# allows 40 (deployment/mysql/my.cnf); the unit runs 2 workers => max 20.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# --- Authentication -------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=voice-ledger
ACCESS_TOKEN_EXPIRE_MINUTES=720
PASSWORD_MIN_LENGTH=8

# --- Locale ---------------------------------------------------------------
DEFAULT_TIMEZONE=Asia/Kolkata

# --- Currency integration (no hard-coded rates) ---------------------------
# open.er-api.com is free and requires no API key. The service calls
# {EXCHANGE_RATE_BASE_URL}/{BASE_CURRENCY} and reads rates["INR"].
EXCHANGE_RATE_BASE_URL=https://open.er-api.com/v6/latest
EXCHANGE_RATE_CACHE_MINUTES=60
EXCHANGE_RATE_TIMEOUT_SECONDS=8

# --- Optional admin bootstrap --------------------------------------------
# If both values are set, the server creates this admin on startup when it
# does not already exist. Leave blank in production if you seed manually.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Ledger Administrator

# --- Administration / maintenance ----------------------------------------
BACKUP_DIR=/var/backups/voice_ledger
ALEMBIC_CONFIG_PATH=alembic.ini
