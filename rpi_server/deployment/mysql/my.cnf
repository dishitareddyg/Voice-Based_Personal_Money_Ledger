# /etc/my.cnf - MySQL 8.0 tuned for a Raspberry Pi 4B with 2 GB RAM.
#
# MySQL is the ONLY database on this host and shares RAM with Raspberry Pi OS
# (~250 MB), Nginx (~20 MB) and the FastAPI app (2 Uvicorn workers,
# ~250-300 MB). Budget for MySQL: roughly 450-550 MB resident, leaving
# 600+ MB for the page cache and headroom. Do not raise these values unless
# `free -m` shows >500 MB "available" under load.
#
# Paths match deployment/README.md (generic tarball in /opt/mysql). If you use
# a distribution package, keep the tuning block and drop the path lines.

[mysqld]
user=mysql
basedir=/opt/mysql
datadir=/var/lib/mysql
socket=/var/run/mysqld/mysqld.sock
pid-file=/var/run/mysqld/mysqld.pid
log-error=/var/log/mysql/error.log
secure-file-priv=/var/lib/mysql-files

# --- Network / security ---------------------------------------------------
bind-address=127.0.0.1
skip-name-resolve
mysqlx=0                      # X Plugin is unused: saves a listener + memory

# --- Character set / time ---------------------------------------------------
character-set-server=utf8mb4
collation-server=utf8mb4_0900_ai_ci
default-time-zone='+00:00'    # the app stores naive UTC DATETIME values

# --- Memory ------------------------------------------------------------------
performance_schema=OFF        # saves ~100-300 MB on 8.0; not needed here
innodb_buffer_pool_size=256M  # whole ledger fits; ~50% of MySQL's budget
innodb_buffer_pool_instances=1
innodb_log_buffer_size=8M
innodb_redo_log_capacity=128M # 8.0.30+; replaces innodb_log_file_size
innodb_flush_method=O_DIRECT  # avoid caching InnoDB pages twice in the OS
innodb_buffer_pool_dump_at_shutdown=ON
innodb_buffer_pool_load_at_startup=ON

# Per-connection buffers: keep small, there are at most 40 connections.
max_connections=40
thread_cache_size=8
table_open_cache=400
table_definition_cache=400
tmp_table_size=16M
max_heap_table_size=16M
sort_buffer_size=256K
join_buffer_size=256K
read_buffer_size=128K
read_rnd_buffer_size=256K
max_allowed_packet=16M

# --- Durability vs. SD-card wear ---------------------------------------------
# Keep full durability for financial data (the default, stated explicitly).
innodb_flush_log_at_trx_commit=1
sync_binlog=1
# Binary logging is off: no replication/point-in-time recovery is used, and
# the binlog would add constant writes. Nightly mysqldump is the backup
# (deployment/README.md section 10). Remove this line if you add a replica.
skip-log-bin

# Audit rows are written on every API request; prefer an SSD/USB boot drive
# to an SD card for /var/lib/mysql.

# --- Housekeeping ----------------------------------------------------------------
innodb_lock_wait_timeout=20   # fail fast instead of stalling a request
slow_query_log=OFF
host_cache_size=0

[client]
socket=/var/run/mysqld/mysqld.sock
default-character-set=utf8mb4
